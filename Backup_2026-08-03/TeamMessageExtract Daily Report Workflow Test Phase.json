      "id": "2cae33a3-ed51-44f2-bcd3-aae5574daef5",
      "name": "Is New Combo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        10336,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get the incoming activity date+employee from the loop context\n// $('Append rows to table').first() has the activity that was just written\nconst actDate = $('Parse JSON Response').first().json.date;       // e.g. \"05-May-2026\"\nconst actEmp  = $('Parse JSON Response').first().json.employee;   // e.g. \"Saw Yu San\"\n\n// Rows read from Monthly Summary C8:D57\n// Each row = { C: dateValue, D: employeeValue }\nconst summaryRows = $input.all().map(r => r.json);\n\n// Normalise date for comparison: strip time portion if datetime string\nfunction normDate(d) {\n  if (!d) return '';\n  // If it looks like ISO datetime, take date part only\n  return String(d).split('T')[0].toLowerCase().trim();\n}\n\n// Also normalise the incoming actDate (could be \"05-May-2026\" or \"2026-05-06\")\nconst normAct = normDate(actDate);\n\n// Find first blank row index (0-based within C8:D57 → Excel row = index + 8)\nlet blankRowIndex = -1;\nlet alreadyExists = false;\n\nfor (let i = 0; i < summaryRows.length; i++) {\n  const rowDate = normDate(summaryRows[i]['C'] || summaryRows[i]['column_0'] || '');\n  const rowEmp  = String(summaryRows[i]['D'] || summaryRows[i]['column_1'] || '').toLowerCase().trim();\n  const actEmpNorm = actEmp.toLowerCase().trim();\n\n  if (rowDate && rowEmp) {\n    // Row is populated — check if it matches\n    if ((rowDate === normAct || rowDate.includes(normAct) || normAct.includes(rowDate)) && rowEmp === actEmpNorm) {\n      alreadyExists = true;\n      break;\n    }\n  } else if (!rowDate && !rowEmp && blankRowIndex === -1) {\n    // First blank row found\n    blankRowIndex = i;\n  }\n}\n\nif (alreadyExists) {\n  // Return empty → IF node will skip the write\n  return [{ json: { skip: true, reason: 'Combo already exists in Monthly Summary' } }];\n}\n\nif (blankRowIndex === -1) {\n  return [{ json: { skip: true, reason: 'No blank rows left in Monthly Summary — extend the sheet' } }];\n}\n\n// Excel row number for this blank slot (data starts at row 8)\nconst excelRow = blankRowIndex + 8;\n\nreturn [{\n  json: {\n    skip: false,\n    excelRow,\n    date: actDate,\n    employee: actEmp,\n    dateCell: \\`C\\${excelRow}\\`,\n    employeeCell: \\`D\\${excelRow}\\`\n  }\n}];"
      },
