    {
      "parameters": {
        "jsCode": "// Build the Telegram message.\n// Priority: extracted sign-in link > extracted OTP > whole email (default per spec).\n\nconst email = $input.first().json;\nconst plainText = email.text || email.snippet || '';\nconst htmlBody  = email.html || '';\nconst subject   = email.subject || '(no subject)';\n\n// Robust Extract: Handles flat text layouts or nested address blocks safely\nconst from = email.from.text || (email.from.value && email.from.value[0] && email.from.value[0].address) || 'unknown';\n\nconst esc = (s) => String(s)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst loginKw = /(sign[\\s\\-_]?in|log[\\s\\-_]?in|verify|confirm|magic|auth|token|otp|secure[\\s\\-_]?link)/i;\n\n// --- Try to extract a sign-in link ---\nlet extractedLink = null;\nif (htmlBody) {\n  const anchorRe = /<a[^>]+href=[\"']([^\"']+)[\"'][^>]*>([\\s\\S]*?)<\\/a>/gi;\n  let m;\n  while ((m = anchorRe.exec(htmlBody)) !== null) {\n    const url = m[1];\n    const text = m[2].replace(/<[^>]+>/g, '').trim();\n    if (!url.startsWith('http')) continue;\n    if (loginKw.test(url) || loginKw.test(text)) {\n      extractedLink = url;\n      break;\n    }\n  }\n}\nif (!extractedLink) {\n  const urlRe = /https?:\\/\\/[^\\s\"'<>)\\]]+/gi;\n  const all = (plainText + ' ' + htmlBody).match(urlRe) || [];\n  extractedLink = all.find(u => loginKw.test(u)) || null;\n}\n\n// --- Try to extract an OTP (context-aware) ---\nlet extractedOtp = null;\nconst htmlAsText = htmlBody.replace(/<[^>]+>/g, ' ');\nconst searchText = plainText + '\\n' + htmlAsText;\nconst ctxRe = /(?:code|otp|pin|verification|verify|passcode|one[\\s\\-]?time)[^\\d]{0,30}([0-9][0-9\\s\\-]{3,9}[0-9])/i;\nconst ctxMatch = searchText.match(ctxRe);\nif (ctxMatch) {\n  extractedOtp = ctxMatch[1].replace(/\\s/g, '');\n}\nif (!extractedOtp) {\n  const standaloneRe = /(?:^|\\n)\\s*([0-9]{4,8})\\s*(?:$|\\n)/m;\n  const sMatch = searchText.match(standaloneRe);\n  if (sMatch) extractedOtp = sMatch[1];\n}\n\n// --- Build message ---\nlet message;\nif (extractedLink) {\n  message = `🔗 <b>Sign-in Link</b>\\nFrom: ${esc(from)}\\nSubject: ${esc(subject)}\\n\\n${esc(extractedLink)}`;\n} else if (extractedOtp) {\n  message = `🔑 <b>OTP Code</b>\\nFrom: ${esc(from)}\\nSubject: ${esc(subject)}\\n\\n<code>${esc(extractedOtp)}</code>`;\n} else {\n  // Default path: Fallback to the whole email if no link or OTP is found (Per Spec)\n  const body = (plainText && plainText.trim()) || htmlAsText.replace(/\\s+/g, ' ').trim() || '(no body)';\n  const header = `📧 <b>Email Forwarded</b>\\nFrom: ${esc(from)}\\nSubject: ${esc(subject)}\\n\\n`;\n  const TELEGRAM_LIMIT = 4096;\n  const room = TELEGRAM_LIMIT - header.length - 20;\n  const escBody = esc(body);\n  message = escBody.length > room\n    ? header + escBody.substring(0, room) + '\\n[truncated]'\n    : header + escBody;\n}\n\nreturn [{ json: { message } }];"
      },
