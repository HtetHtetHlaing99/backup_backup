      "parameters": {
        "jsCode": "const json = $input.first().json;\n\n// Handle both string and object formats\nlet raw = json.from || json.From || '';\nif (typeof raw === 'object') {\n  raw = raw.text || raw.value || raw.address || '';\n}\nraw = String(raw);\n\nconst match = raw.match(/@([\\w.-]+)/);\nconst senderDomain = match ? '@' + match[1].toLowerCase() : null;\nreturn [{ json: { ...json, senderDomain } }];"
      },
