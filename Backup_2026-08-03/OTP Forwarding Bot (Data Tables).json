      "parameters": {
        "jsCode": "// === ADMIN AUTHORIZATION ===\nconst ADMIN_CHAT_IDS = [-5086861113];\nconst ADMIN_USER_IDS = [];\n\nconst json = $input.first().json;\nconst chatId = Number(json.chatId);\nconst userId = Number(json.userId);\n\nconst chatOk = ADMIN_CHAT_IDS.includes(chatId);\nconst userOk = ADMIN_USER_IDS.length > 0 && ADMIN_USER_IDS.includes(userId);\n\nif (!chatOk && !userOk) return [];\nreturn [{ json }];"
      },
