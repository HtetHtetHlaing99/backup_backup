      {
        "parameters": {
          "jsCode": "// 1. Check if all upstream nodes have finished running\ntry {\n  const nodeA = $node[\"Download the DGTInternDailyReport File\"];\n  const nodeB = $node[\"Download the P&LDailyReport File\"];\n  const nodeC = $node[\"Download the SOPDailyReport File\"];\n  \n  // If any of them haven't produced binary data yet, stop execution here\n  if (!nodeA.binary || !nodeB.binary || !nodeC.binary) {\n    return []; \n  }\n  \n  const item = { json: {}, binary: {} };\n\n  // Grab DGT File\n  const keyA = Object.keys(nodeA.binary)[0];\n  item.binary[\"DGT_Report\"] = nodeA.binary[keyA];\n  item.binary[\"DGT_Report\"].fileName = nodeA.binary[keyA].fileName || \"DGT_Daily_Report.xlsx\";\n\n  // Grab P&L File\n  const keyB = Object.keys(nodeB.binary)[0];\n  item.binary[\"PL_Report\"] = nodeB.binary[keyB];\n  item.binary[\"PL_Report\"].fileName = nodeB.binary[keyB].fileName || \"PL_Daily_Report.xlsx\";\n\n  // Grab SOP File\n  const keyC = Object.keys(nodeC.binary)[0];\n  item.binary[\"SOP_Report\"] = nodeC.binary[keyC];\n  item.binary[\"SOP_Report\"].fileName = nodeC.binary[keyC].fileName || \"SOP_Daily_Report.xlsx\";\n\n  return [item];\n\n} catch (e) {\n  // If nodes aren't ready or named correctly, return nothing to prevent partial emails\n  return [];\n}"
        },
