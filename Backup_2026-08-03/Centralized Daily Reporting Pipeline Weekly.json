      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "lic4au4tgDpc8qwV",
          "name": "Microsoft Outlook Owner HHH not Auto"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = { json: {}, binary: {} };\n\n// 1. Grab DGT File with its real name\ntry {\n  const nodeA = $node[\"Download the DGTInternDailyReport File\"];\n  const firstKey = Object.keys(nodeA.binary)[0];\n  const realName = nodeA.binary[firstKey].fileName || \"DGT_Daily_Report.xlsx\";\n  \n  // We sanitize the key name for n8n, but preserve the metadata inside\n  item.binary[\"DGT_Report\"] = nodeA.binary[firstKey];\n  item.binary[\"DGT_Report\"].fileName = realName;\n} catch (e) {\n  console.log(\"DGT File not found\");\n}\n\n// 2. Grab P&L File with its real name\ntry {\n  const nodeB = $node[\"Download the P&LDailyReport File\"];\n  const firstKey = Object.keys(nodeB.binary)[0];\n  const realName = nodeB.binary[firstKey].fileName || \"PL_Daily_Report.xlsx\";\n  \n  item.binary[\"PL_Report\"] = nodeB.binary[firstKey];\n  item.binary[\"PL_Report\"].fileName = realName;\n} catch (e) {\n  console.log(\"P&L File not found\");\n}\n\n// 3. Grab SOP File with its real name\ntry {\n  const nodeC = $node[\"Download the SOPDailyReport File\"];\n  const firstKey = Object.keys(nodeC.binary)[0];\n  const realName = nodeC.binary[firstKey].fileName || \"SOP_Daily_Report.xlsx\";\n  \n  item.binary[\"SOP_Report\"] = nodeC.binary[firstKey];\n  item.binary[\"SOP_Report\"].fileName = realName;\n} catch (e) {\n  console.log(\"SOP File not found\");\n}\n\nreturn [item];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
