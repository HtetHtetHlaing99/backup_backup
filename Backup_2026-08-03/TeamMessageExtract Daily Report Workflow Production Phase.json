    {
      "parameters": {
        "jsCode": "const actDate = $('Parse JSON Response1').first().json.date;\nconst actEmp  = $('Parse JSON Response1').first().json.employee;\n\nconst summaryRows = $input.all().map(r => r.json);\n\nfunction normDate(d) {\n  if (!d) return '';\n  return String(d).split('T')[0].toLowerCase().trim();\n}\n\nconst normAct = normDate(actDate);\n\nlet blankRowIndex = -1;\nlet alreadyExists = false;\n\n// Row 7 is header (index 0), data starts at index 1 = Excel row 8\nfor (let i = 1; i < summaryRows.length; i++) {\n  const keys = Object.keys(summaryRows[i]);\n  const dateKey = keys[0];\n  const empKey  = keys[1];\n  const rowDate = normDate(summaryRows[i][dateKey] || '');\n  const rowEmp  = String(summaryRows[i][empKey] || '').toLowerCase().trim();\n  const actEmpNorm = actEmp.toLowerCase().trim();\n\n  if (rowDate && rowEmp) {\n    if ((rowDate === normAct || rowDate.includes(normAct) || normAct.includes(rowDate)) && rowEmp === actEmpNorm) {\n      alreadyExists = true;\n      break;\n    }\n  } else if (!rowDate && !rowEmp && blankRowIndex === -1) {\n    blankRowIndex = i;\n  }\n}\n\nif (alreadyExists) {\n  return [{ json: { skip: true, reason: 'Combo already exists in Monthly Summary' } }];\n}\n\nif (blankRowIndex === -1) {\n  return [{ json: { skip: true, reason: 'No blank rows left in Monthly Summary' } }];\n}\n\n// blankRowIndex is relative to C7 (index 0 = row 7), so Excel row = blankRowIndex + 7\nconst excelRow = blankRowIndex + 7;\n\nreturn [{\n  json: {\n    skip: false,\n    excelRow,\n    date: actDate,\n    employee: actEmp,\n    dateCell: 'C' + excelRow,\n    employeeCell: 'D' + excelRow\n  }\n}];"
      },
