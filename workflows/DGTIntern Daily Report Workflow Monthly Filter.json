      "id": "24165ee7-7a83-4e7b-ab1f-3e749cbbbf15",
      "name": "Is New Combo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        10240,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const actDate = $('Parse JSON Response').first().json.date;\nconst actEmp  = $('Parse JSON Response').first().json.employee;\n\nconst summaryRows = $input.all().map(r => r.json);\n\nfunction normDate(d) {\n  if (!d) return '';\n  return String(d).split('T')[0].toLowerCase().trim();\n}\n\nconst normAct = normDate(actDate);\n\nlet blankRowIndex = -1;\nlet alreadyExists = false;\n\n// C6:D56 range — ALL rows are data rows, no header, start from index 0\nfor (let i = 0; i < summaryRows.length; i++) {\n  const rowDate = normDate(summaryRows[i].Date || '');\n  const rowEmp  = String(summaryRows[i].Employee || '').toLowerCase().trim();\n  const actEmpNorm = actEmp.toLowerCase().trim();\n\n  if (rowDate && rowEmp) {\n    if (\n      (rowDate === normAct || rowDate.includes(normAct) || normAct.includes(rowDate)) &&\n      rowEmp === actEmpNorm\n    ) {\n      alreadyExists = true;\n      break;\n    }\n  } else if (!rowDate && !rowEmp && blankRowIndex === -1) {\n    blankRowIndex = i;\n  }\n}\n\nif (alreadyExists) {\n  return [{ json: { skip: true, reason: 'Combo already exists in Monthly Summary' } }];\n}\n\nif (blankRowIndex === -1) {\n  return [{ json: { skip: true, reason: 'No blank rows left in Monthly Summary' } }];\n}\n\n// blankRowIndex 0 = row 6 in Excel, so Excel row = blankRowIndex + 6\nconst excelRow = blankRowIndex + 6;\n\nreturn [{\n  json: {\n    skip: false,\n    excelRow,\n    date: actDate,\n    employee: actEmp,\n    dateCell: 'C' + excelRow,\n    employeeCell: 'D' + excelRow\n  }\n}];"
      },
