    {
      "parameters": {
        "jsCode": "const chatInput = items[0].json.chatInput || \"\";\nconst sessionId = items[0].json.sessionId || \"\"; // sessionId ကိုပါ လက်ခံမယ်\nconst burmeseRegex = /[\\u1000-\\u109F]/;\nlet language = burmeseRegex.test(chatInput) ? \"my\" : \"en\";\n\nreturn {\n    language: language,\n    chatInput: chatInput,\n    sessionId: sessionId // sessionId ကိုပါ ပြန်ထုတ်ပေးမယ်\n};"
